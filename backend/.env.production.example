# Reference for a DEPLOYED backend configuration (staging or production).
#
# This file is documentation only - it is NEVER copied to a server and NEVER
# holds a real value. On Render:
#   * non-secret values live in the environment group in render.yaml
#     (ledgerdrop-staging / ledgerdrop-production)
#   * secret values (marked "SECRET" below) are declared on the backend service
#     with `sync: false` and are entered at Blueprint apply time - Render stores
#     them, this repo does not.
#
# ENVIRONMENT=staging or production makes app/core/config.py enforce every rule
# below at process start; a missing or unsafe value stops the boot.

# --- Application ---
ENVIRONMENT=production
DEBUG=false
LOG_FORMAT=json
# Exact browser origin(s) of the frontend for this environment. No localhost.
CORS_ALLOW_ORIGINS=https://ledgerdrop-frontend.onrender.com
# Exact backend hostname(s). No "*".
TRUSTED_HOSTS=ledgerdrop-backend.onrender.com

# --- Database ---
# Injected by Render from the managed database (render.yaml `fromDatabase`).
# A driver-less "postgresql://" URL is accepted; config coerces it to asyncpg.
# DATABASE_URL=  (SECRET - provided by the platform, not set by hand)

# --- File storage: Cloudflare R2 over the S3 API ---
STORAGE_BACKEND=s3
S3_BUCKET=ledgerdrop-uploads
S3_REGION=auto
S3_KEY_PREFIX=
# https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=            # SECRET (carries the account id)
S3_ACCESS_KEY_ID=           # SECRET (R2 API token)
S3_SECRET_ACCESS_KEY=       # SECRET (R2 API token)

# --- Stage 2 document limits ---
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=10

# --- Extraction provider: OpenAI GPT-5-mini (required when deployed) ---
EXTRACTION_PROVIDER=openai
OPENAI_MODEL=gpt-5-mini
EXTRACTION_PROVIDER_TIMEOUT_SECONDS=60
OPENAI_API_KEY=             # SECRET (OpenAI dashboard)

# --- Edge hardening (Stage 9 Package 5) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute

# --- Error monitoring (Stage 9 Packages 6-7) ---
SENTRY_DSN=                 # SECRET (Sentry project DSN); optional
