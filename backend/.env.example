# Copy to backend/.env and adjust for your machine. Do NOT commit backend/.env.
# For a deployed (staging/production) configuration see .env.production.example.

# --- Application ---
ENVIRONMENT=development
DEBUG=false
# text (human-readable, dev default) or json (deployed environments).
LOG_FORMAT=text
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Comma-separated Host header allow-list. "*" is fine for local development;
# deployed environments must pin explicit hostnames.
TRUSTED_HOSTS=*

# --- Database ---
# Async SQLAlchemy URL. Matches the credentials in docker-compose.yml.
# A driver-less "postgresql://" URL is accepted and coerced to asyncpg.
DATABASE_URL=postgresql+asyncpg://ledgerdrop:ledgerdrop@localhost:5432/ledgerdrop
DB_ECHO=false

# --- File storage ---
# local  -> filesystem under UPLOAD_DIRECTORY (development/test default)
# s3     -> S3-compatible object storage (Cloudflare R2); see .env.production.example
STORAGE_BACKEND=local
# Relative paths are resolved against the repository root.
UPLOAD_DIRECTORY=storage/uploads
# S3 settings are unused when STORAGE_BACKEND=local.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=

# --- Stage 2 document limits ---
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=10

# --- Stage 3 extraction provider ---
# Selected provider: OpenAI GPT-5-mini (see docs/provider-selection.md).
# Azure AI Document Intelligence remains a candidate for a later migration.
EXTRACTION_PROVIDER=fake
# openai | fake  (deployed environments must use openai)
# OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini
EXTRACTION_PROVIDER_TIMEOUT_SECONDS=60

# --- Stage 9 edge hardening (middleware active from Package 5) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute

# --- Stage 9 error monitoring (active from Packages 6-7) ---
# SENTRY_DSN=
