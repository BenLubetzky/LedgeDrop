# Copy to backend/.env and adjust for your machine. Do NOT commit backend/.env.

# --- Application ---
ENVIRONMENT=development
DEBUG=false
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database ---
# Async SQLAlchemy URL. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://ledgerdrop:ledgerdrop@localhost:5432/ledgerdrop
DB_ECHO=false

# --- File storage ---
# Relative paths are resolved against the repository root.
UPLOAD_DIRECTORY=storage/uploads

# --- Stage 2 document limits ---
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=10

# --- Stage 3 extraction provider ---
# Selected provider: Azure AI Document Intelligence prebuilt-invoice
# (see docs/provider-selection.md). Not wired until step 12 - the app runs on
# the deterministic offline fake regardless of these values.
EXTRACTION_PROVIDER=fake
# azure_document_intelligence | aws_textract | fake
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-me-or-use-managed-identity
# EXTRACTION_PROVIDER_TIMEOUT_SECONDS=60
