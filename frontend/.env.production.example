# Reference for a DEPLOYED frontend configuration (staging or production).
#
# Documentation only - never copied to a server, never holds a real value.
# On Render this value is set on the frontend service in render.yaml.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time, so
# staging and production images are built separately and a change requires a
# rebuild, not just a restart.

# Public origin of the backend API for this environment (scheme + host, no
# trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://ledgerdrop-backend.onrender.com
